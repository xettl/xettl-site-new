# Copy to .env for Netlify Dev. Never put real keys in this tracked example.
# Build-visible public values:
XETTL_WAITLIST_ENDPOINT=/api/waitlist
XETTL_CONTACT_EMAIL=privacy@getxettl.com
# Optional PostHog public PROJECT token, not a personal API key:
XETTL_POSTHOG_TOKEN=
XETTL_POSTHOG_HOST=https://us.i.posthog.com
# Public GA4 web Measurement ID. Set with PostHog to run both simultaneously.
XETTL_GA4_ID=
# Local testing only; Netlify production enables configured analytics automatically.
XETTL_ANALYTICS_PREVIEW=false

# Netlify Functions secrets (set in the dashboard, production context):
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
RATE_LIMIT_SECRET=
XETTL_ALLOWED_ORIGINS=https://getxettl.com,https://www.getxettl.com
